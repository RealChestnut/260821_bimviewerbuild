ISO-10303-21;
/* ============================================================================
 * three-elements-ifc4.ifc — 읽는 법과 고치는 법
 *
 * 손으로 쓴 테스트 fixture다. Viewer의 다중 선택, 공간 구조 트리, 속성 패널,
 * 4D 일정 바인딩을 시험하려고 최소한의 부재 3개(벽 2, 슬래브 1)만 담았다.
 * 검사 항목표는 packages/test-fixtures/README.md에 있다.
 *
 * 파일 형식 (STEP 물리 파일, ISO 10303-21)
 *   HEADER 구역   파일 이름, 작성 시각, 스키마 이름
 *   DATA 구역     "#번호=ENTITY(인자,...);" 한 줄에 개체 하나
 *   "#번호"는 이 파일 안에서만 유효한 참조다. 다른 개체를 가리킬 때 쓴다.
 *   "$"는 값 없음, "*"는 상위 문맥이 정한다, ".ENUM."은 열거값이다.
 *   이 별표 블록처럼 감싼 구간은 주석이며 파서가 건너뛴다.
 *
 * 무엇을 바꾸려면 어디를 고치나
 *   부재를 옮긴다        해당 부재의 IFCCARTESIANPOINT — #100 / #110 / #120
 *   부재 크기를 바꾼다   IFCRECTANGLEPROFILEDEF의 가로·세로 — #103 / #114 / #123
 *                        와 IFCEXTRUDEDAREASOLID의 압출 길이 — #104 / #115 / #124
 *   부재 이름을 바꾼다   IFCWALL·IFCSLAB 줄의 세 번째 인자 — 'Wall A' 등
 *   부재를 하나 늘린다   #100~#107 묶음을 통째로 복사해 번호와 GlobalId를 새로
 *                        만들고, #203의 부재 목록에 그 부재를 넣는다.
 *                        #203에 넣지 않으면 공간 구조 트리에 나타나지 않는다.
 *   속성을 붙인다        #210 이후 구역. IFCPROPERTYSET으로 묶고
 *                        IFCRELDEFINESBYPROPERTIES로 대상 부재에 건다
 *   층을 늘린다          #42 배치와 #52 층을 복사하고 #202의 목록에 추가한다
 *
 * GlobalId를 손댈 때 주의
 *   22자, 문자 집합은 0-9 A-Z a-z _ $, 첫 글자는 0-3이어야 한다.
 *   부재의 GlobalId는 일정 fixture(packages/test-fixtures/schedule/ 아래 JSON)의
 *   productGlobalId와 짝을 이룬다. 한쪽만 바꾸면 4D 바인딩이 조용히 끊긴다.
 *   src/fixtures.test.ts가 형식·중복·짝을 모두 검사하므로 고친 뒤 테스트를 돌린다.
 *
 * 좌표 단위는 미터다(#10). 벽은 6.0 x 0.2 x 3.0, 슬래브는 6.0 x 4.0 x 0.2.
 * ============================================================================ */
HEADER;
/* 파일 설명과 STEP 구현 판. '2;1'은 형식 고정값이라 건드리지 않는다. */
FILE_DESCRIPTION((''),'2;1');
/* 파일 이름, 작성 시각(ISO 8601), 작성자, 조직, 전처리기, 작성 시스템, 인가.
   여기 적힌 이름은 표시용 문자열일 뿐이다. 일정의 modelRef는 실제 파일명과 맞춘다. */
FILE_NAME('three-elements-ifc4.ifc','2026-08-21T00:00:00',(''),(''),'bim4d-fixture','bim4d-fixture','');
/* 스키마 이름. Viewer는 파일명이나 확장자가 아니라 이 값으로 판을 정한다.
   IFC2X3로 바꾸면 아래 DATA 구역의 개체 인자 개수도 함께 달라진다. */
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;

/* ---------------------------------------------------------------------------
 * 소유 이력 — 누가 언제 만들었는지. 모든 IfcRoot 개체의 두 번째 인자로 쓰인다.
 * 형상이나 화면에는 영향을 주지 않는다. 비워 둘 수 없어 최소한으로만 채웠다.
 * ------------------------------------------------------------------------- */
#1=IFCPERSON($,'Fixture',$,$,$,$,$,$);
#2=IFCORGANIZATION($,'bim4d',$,$,$);
#3=IFCPERSONANDORGANIZATION(#1,#2,$);
#4=IFCAPPLICATION(#2,'0.0.0','bim4d fixture writer','bim4d');
/* .ADDED.는 변경 상태, 끝의 0은 생성 시각(Unix time)이다. */
#5=IFCOWNERHISTORY(#3,#4,$,.ADDED.,$,$,$,0);

/* ---------------------------------------------------------------------------
 * 단위 — 길이는 미터, 면적은 제곱미터, 부피는 세제곱미터.
 * 밀리미터로 바꾸려면 #10에 접두 배율을 넣고 아래 좌표와 치수를 전부 1000배로
 * 고쳐야 한다. 한쪽만 바꾸면 모델이 1000배로 커지거나 작아진다.
 * ------------------------------------------------------------------------- */
#10=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#11=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#12=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#13=IFCUNITASSIGNMENT((#10,#11,#12));

/* ---------------------------------------------------------------------------
 * 전역 좌표계와 표현 문맥 — 모델 전체의 원점과 축, 그리고 형상을 담는 문맥.
 * ------------------------------------------------------------------------- */
#20=IFCCARTESIANPOINT((0.,0.,0.));
/* Z축. 위 방향이자 아래 세 부재의 압출 방향이다. */
#21=IFCDIRECTION((0.,0.,1.));
/* X축 기준 방향. */
#22=IFCDIRECTION((1.,0.,0.));
/* 원점 + Z + X = 전역 좌표계. 아래에서 여러 번 재사용한다. */
#23=IFCAXIS2PLACEMENT3D(#20,#21,#22);
/* 3차원 모델 문맥. 1.E-05는 형상 비교 허용 오차다. */
#24=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#23,$);
/* 'Body' 하위 문맥. 부피를 가진 형상은 모두 여기에 매단다.
   Viewer가 그리는 대상이 이 문맥의 형상이다. */
#25=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#24,$,.MODEL_VIEW.,$);

/* 프로젝트 — 공간 계층의 뿌리. 표현 문맥(#24)과 단위(#13)를 여기서 묶는다. */
#30=IFCPROJECT('0hT6cQ2kv9NrXbW8ySmLdP',#5,'Fixture Project',$,$,$,$,(#24),#13);

/* ---------------------------------------------------------------------------
 * 배치 사슬 — 각 층위의 좌표계를 상위에 이어 붙인다. 상위를 옮기면 하위가 따라간다.
 * 여기서는 셋 다 전역 좌표계(#23)를 그대로 써서 이동도 회전도 없다.
 * #40 대지 → #41 건물 → #42 층. 부재는 #42를 기준으로 놓인다.
 * ------------------------------------------------------------------------- */
#40=IFCLOCALPLACEMENT($,#23);
#41=IFCLOCALPLACEMENT(#40,#23);
#42=IFCLOCALPLACEMENT(#41,#23);

/* ---------------------------------------------------------------------------
 * 공간 계층 — Project > Site > Building > Storey. 공간 구조 트리가 이 사슬을 읽는다.
 * 아래 셋은 개체 선언일 뿐이고, 실제 부모-자식 연결은 #200~#203 관계 개체가 만든다.
 * 개체만 만들고 관계를 빠뜨리면 트리에 뜨지 않는다.
 * ------------------------------------------------------------------------- */
#50=IFCSITE('1KpRfB7wz4MgVaJ2xTnQcE',#5,'Fixture Site',$,$,#40,$,$,.ELEMENT.,$,$,$,$,$);
#51=IFCBUILDING('2XdNvS9ur6LhZmC1kBwYtF',#5,'Fixture Building',$,$,#41,$,$,.ELEMENT.,$,$,$);
/* 마지막 인자 0.은 층 고도(Elevation)다. 2층을 만들면 여기에 층고를 적는다. */
#52=IFCBUILDINGSTOREY('3QwLmT5ce8KjYbV0rPzHdG',#5,'Level 1',$,$,#42,$,$,.ELEMENT.,0.);

/* 단면 프로파일이 공유하는 2D 원점. 세 부재가 모두 이것을 재사용한다. */
#60=IFCCARTESIANPOINT((0.,0.));
#61=IFCAXIS2PLACEMENT2D(#60,$);

/* ---------------------------------------------------------------------------
 * 부재 1 — Wall A. 아래 여덟 줄이 부재 하나를 이루는 표준 묶음이다.
 *   위치 → 배치 → 단면 → 압출 → 형상 표현 → 형상 묶음 → 부재
 * 부재를 늘리려면 이 여덟 줄을 복사해 번호와 GlobalId만 새로 붙이면 된다.
 * ------------------------------------------------------------------------- */
/* Wall A 위치. 벽을 옮기려면 이 좌표를 고친다. */
#100=IFCCARTESIANPOINT((0.,0.,0.));
#101=IFCAXIS2PLACEMENT3D(#100,#21,#22);
/* 층(#42) 기준 배치. 층을 옮기면 이 벽도 따라 움직인다. */
#102=IFCLOCALPLACEMENT(#42,#101);
/* 단면: 가로 6.0 x 세로 0.2. 벽의 길이와 두께다. */
#103=IFCRECTANGLEPROFILEDEF(.AREA.,'wall-a-profile',#61,6.,0.2);
/* 단면을 Z축(#21)으로 3.0 뽑는다. 이 3.이 벽 높이다. */
#104=IFCEXTRUDEDAREASOLID(#103,#23,#21,3.);
/* 'Body' 문맥(#25)에 압출 솔리드로 등록. Viewer가 그리는 것이 이 표현이다. */
#105=IFCSHAPEREPRESENTATION(#25,'Body','SweptSolid',(#104));
#106=IFCPRODUCTDEFINITIONSHAPE($,$,(#105));
/* 부재 본체. 인자 순서는
   GlobalId, 소유이력, 이름, 설명, 타입, 배치, 형상, 태그, 세부구분이다.
   'WALL-A'는 태그(외부 시스템 식별자), .STANDARD.는 벽의 세부 구분이다.
   맨 앞 GlobalId가 일정 fixture의 productGlobalId와 짝을 이룬다. */
#107=IFCWALL('0BnKdW4tq7SfUcM3vHxZgR',#5,'Wall A',$,$,#102,#106,'WALL-A',.STANDARD.);

/* ---------------------------------------------------------------------------
 * 부재 2 — Wall B. Wall A와 치수가 같고, Y로 4.0 떨어져 축 방향만 다르다.
 * 두 벽이 화면에서 겹치지 않게 하려고 이렇게 두었다.
 * ------------------------------------------------------------------------- */
/* Wall A에서 Y로 +4.0 떨어진 자리. */
#110=IFCCARTESIANPOINT((0.,4.,0.));
/* X 기준 방향을 Y축으로 돌린다. 그래서 Wall B는 90도 돌아선다. */
#111=IFCDIRECTION((0.,1.,0.));
#112=IFCAXIS2PLACEMENT3D(#110,#21,#111);
#113=IFCLOCALPLACEMENT(#42,#112);
#114=IFCRECTANGLEPROFILEDEF(.AREA.,'wall-b-profile',#61,6.,0.2);
#115=IFCEXTRUDEDAREASOLID(#114,#23,#21,3.);
#116=IFCSHAPEREPRESENTATION(#25,'Body','SweptSolid',(#115));
#117=IFCPRODUCTDEFINITIONSHAPE($,$,(#116));
#118=IFCWALL('1MjTgR8dp5NkXbC2wFyQsA',#5,'Wall B',$,$,#113,#117,'WALL-B',.STANDARD.);

/* ---------------------------------------------------------------------------
 * 부재 3 — Slab 1. 두 벽 사이의 바닥. 서로 다른 Entity를 섞어야 분류와 다중
 * 선택을 제대로 시험할 수 있어서 슬래브를 하나 넣었다.
 * ------------------------------------------------------------------------- */
/* 두 벽 가운데(Y=2), 바닥면 아래(Z=-0.2). */
#120=IFCCARTESIANPOINT((0.,2.,-0.2));
#121=IFCAXIS2PLACEMENT3D(#120,#21,#22);
#122=IFCLOCALPLACEMENT(#42,#121);
/* 단면 6.0 x 4.0. 슬래브의 평면 크기다. */
#123=IFCRECTANGLEPROFILEDEF(.AREA.,'slab-profile',#61,6.,4.);
/* 0.2만큼 뽑는다. 슬래브 두께다. Z=-0.2에서 시작하므로 윗면이 Z=0이 된다. */
#124=IFCEXTRUDEDAREASOLID(#123,#23,#21,0.2);
#125=IFCSHAPEREPRESENTATION(#25,'Body','SweptSolid',(#124));
#126=IFCPRODUCTDEFINITIONSHAPE($,$,(#125));
/* .FLOOR.는 슬래브의 세부 구분이다. 지붕이면 .ROOF.를 쓴다. */
#127=IFCSLAB('2YsHnV6bk3PgZdL9uCxWtM',#5,'Slab 1',$,$,#122,#126,'SLAB-1',.FLOOR.);

/* ---------------------------------------------------------------------------
 * 공간 계층 관계 — 앞에서 만든 개체들을 실제로 부모-자식으로 잇는다.
 * IFCRELAGGREGATES는 공간끼리 묶는다. 인자 순서는 부모가 먼저, 자식 목록이 뒤다.
 * IFCRELCONTAINEDINSPATIALSTRUCTURE는 부재를 공간에 담는다. 이쪽은 반대로
 * 부재 목록이 먼저, 담을 공간이 뒤다.
 * ------------------------------------------------------------------------- */
#200=IFCRELAGGREGATES('3FdQzX1mr7TjWbN4pKvSeU',#5,'Project Container',$,#30,(#50));
#201=IFCRELAGGREGATES('0LwCkB9ny2RhYaG6tMdPfJ',#5,'Site Container',$,#50,(#51));
#202=IFCRELAGGREGATES('1TnVsE3gq8ZmXcH5wBjRlK',#5,'Building Container',$,#51,(#52));
/* 부재 3개를 Level 1(#52)에 담는다. 부재를 늘리면 이 목록에 반드시 추가한다. */
#203=IFCRELCONTAINEDINSPATIALSTRUCTURE('2GkPdM7xu4NbYfR1zTcWqO',#5,'Storey Contents',$,(#107,#118,#127),#52);

/* ---------------------------------------------------------------------------
 * 속성 집합 (Pset) — 표준 Pset. 속성 패널이 원본 Pset을 빠짐없이 보여 주는지
 * 확인하는 데 쓴다. 값의 형은 IFCBOOLEAN, IFCLABEL처럼 값 앞에 적는다.
 * 붙이는 방법은 두 단계다. IFCPROPERTYSET으로 묶고,
 * IFCRELDEFINESBYPROPERTIES로 대상 부재 목록에 건다.
 * ------------------------------------------------------------------------- */
#210=IFCPROPERTYSINGLEVALUE('IsExternal',$,IFCBOOLEAN(.T.),$);
#211=IFCPROPERTYSINGLEVALUE('LoadBearing',$,IFCBOOLEAN(.T.),$);
/* Pset_ 접두어는 buildingSMART 표준 이름에만 쓴다. */
#212=IFCPROPERTYSET('3RbNcJ5vt9WkZgD8yHmXpL',#5,'Pset_WallCommon',$,(#210,#211));
/* 두 벽(#107, #118)에만 건다. 슬래브에는 걸지 않는다. */
#213=IFCRELDEFINESBYPROPERTIES('0DjWpF2ks6MgTbY7xVnQcZ',#5,'Wall Properties',$,(#107,#118),#212);

/* 자체 Pset — 예약 접두어 Pset_을 쓰지 않는 사례다 (AGENTS.md 2.4절).
   우리가 만드는 속성 집합은 BIM4D_ 접두어를 쓴다. 슬래브(#127)에만 건다. */
#220=IFCPROPERTYSINGLEVALUE('BIM4D_Zone',$,IFCLABEL('Zone-A'),$);
#221=IFCPROPERTYSET('1HmKvR9zb4NcXjW3tGyPdS',#5,'BIM4D_Custom',$,(#220));
#222=IFCRELDEFINESBYPROPERTIES('2NpTfC6wq8ZkYbM1rDxVhE',#5,'Custom Properties',$,(#127),#221);

/* 수량 집합 (Qto) — Pset과 구조가 같지만 IFCELEMENTQUANTITY로 묶는다.
   속성 패널이 Pset과 Qto를 함께 보여 주는지 확인하려고 Wall A에만 걸었다.
   18.은 6.0 x 3.0, 벽 한 면의 넓이다. */
#230=IFCQUANTITYAREA('NetSideArea',$,$,18.,$);
#231=IFCELEMENTQUANTITY('3VcXmB4yt7RgNdK2sPwZfL',#5,'Qto_WallBaseQuantities',$,$,(#230));
#232=IFCRELDEFINESBYPROPERTIES('0SqYnD8jh5TbWcF6vKzMpR',#5,'Wall Quantities',$,(#107),#231);
ENDSEC;
END-ISO-10303-21;
